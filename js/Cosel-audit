import { db } from './firebase.js';
import { collection, addDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

/**
 * @param {Object} user - User data from Firestore
 * @param {string} action - e.g., "Voting", "Registration"
 * @param {string} details - e.g., "Cast a vote for SC"
 */
export async function createCoselAudit(user, action, details) {
    try {
        // LOGIC: If role exists and is LEADER, use 'Leader'. 
        // Otherwise (if null/undefined), it's a 'Voter'.
        const auditRole = (user.role === 'LEADER') ? 'Leader' : 'Voter';

        await addDoc(collection(db, "audit_logs"), {
            name: user.name || (user.firstName + " " + user.lastName).trim() || "Unknown User",
            role: auditRole, 
            college: user.college || "N/A",
            action: action,
            details: details,
            timestamp: serverTimestamp()
        });
        console.log(`[Audit] ${auditRole} action recorded.`);
    } catch (e) {
        console.error("Audit log failed:", e);
    }
}